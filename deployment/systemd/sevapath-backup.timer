[Unit]
Description=SevaPath 6-Hourly Automated Database Backup Timer (Phase 5.3)
Documentation=file:///opt/sevapath/docs/BACKUP_AND_RECOVERY.md
Requires=sevapath-backup.service

[Timer]
# Deterministic six-hourly calendar schedule: 00:00, 06:00, 12:00, 18:00 UTC
OnCalendar=*-*-* 00,06,12,18:00:00 UTC
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
